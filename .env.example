# Copy to .env and fill in real values. Never commit the real .env (it is gitignored).
# Payhawk REST v3 API. Create a key in the Web Portal:
#   Settings > Integrations > Available integrations > "API connection" > Connect.
# Each developer should use their own key so access can be revoked individually.

# API key (header X-Payhawk-ApiKey). Full-access scope is needed for write-back.
PAYHAWK_API_KEY=

# Full URL incl. account id from GET /api/v3/accounts, e.g.
#   https://api.payhawk.com/api/v3/accounts/amf_bakery_systems_uk_limited_xxxxxxxx_labs_demo
PAYHAWK_BASE_URL=
